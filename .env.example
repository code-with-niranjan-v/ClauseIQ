# Required. Add your OpenAI key to the ignored root .env file.
OPENAI_API_KEY=
# Sample credentials for local development. Keep the PostgreSQL password alphanumeric.
POSTGRES_PASSWORD=ClauseIQPostgresDev2026
NEO4J_PASSWORD=ClauseIQNeo4jDev2026
MINIO_ROOT_USER=clauseiq-minio
MINIO_ROOT_PASSWORD=ClauseIQMinioDev2026

FRONTEND_PORT=5173
BACKEND_PORT=8080
SCANNER_PORT=8081
INGESTION_PORT=8000
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# First ClauseIQ administrator, created only when no accounts exist. Leave the password blank to have
# one generated and printed once in the backend log (docker compose logs clauseiq-backend).
CLAUSEIQ_ADMIN_USERNAME=admin
CLAUSEIQ_ADMIN_PASSWORD=

# Demo NeoPay database for Data discovery. It holds a schema only, no rows.
NEOPAY_DB_PASSWORD=neopay-demo-owner
NEOPAY_SCANNER_PASSWORD=neopay-demo-scan
