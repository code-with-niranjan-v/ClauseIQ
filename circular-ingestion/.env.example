# Required. MinIO credentials must match the ones circular-scanner uploads with.
POSTGRES_PASSWORD=
NEO4J_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Compose network that has the scanner's kafka and minio services.
SCANNER_NETWORK=circular-scanner_default
INGESTION_PORT=8000

# Obligation extraction. Leave LLM_MODEL empty to use the rule-based extractor.
LLM_MODEL=
LLM_PROVIDER=openai
LLM_BASE_URL=
LLM_API_KEY=

# Embeddings. "hash" is a local placeholder. "openai" uses EMBEDDING_MODEL.
# Changing EMBEDDING_DIMENSIONS after the first start needs a new document_chunk table.
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=384
